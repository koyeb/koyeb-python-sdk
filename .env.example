# Required for live Koyeb API calls.
KOYEB_API_TOKEN=

# Optional project and API settings.
KOYEB_PROJECT_ID=
KOYEB_API_HOST=https://app.koyeb.com
KOYEB_REGION=na

# The network-policy examples require this region.
KOYEB_NETWORK_POLICY_REGION=nl-north-1

# The service-pool examples require a metropolitan region.
KOYEB_SERVICE_POOL_REGION=nl-north-1

# Optional snapshot benchmark setting.
KOYEB_SNAPSHOT_BENCHMARK_INSTANCE_TYPE=micro
